{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["version", "coverageFrom", "coverageThrough", "holidays"],
  "properties": {
    "version": { "type": "string", "minLength": 1 },
    "coverageFrom": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "coverageThrough": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "holidays": { "type": "array" }
  }
}
