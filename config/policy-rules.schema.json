{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "dataVersion",
    "retrievedAt",
    "policyVersions",
    "services",
    "peakPeriods",
    "claimWindowBusinessDays"
  ],
  "properties": {
    "dataVersion": { "type": "string", "minLength": 1 },
    "retrievedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
    "policyVersions": { "type": "array", "minItems": 1 },
    "services": { "type": "object", "minProperties": 1 },
    "peakPeriods": { "type": "array" },
    "claimWindowBusinessDays": {
      "type": "integer",
      "minimum": 1,
      "maximum": 365
    }
  }
}
