<?php
/**
 * Imports Canada Post Contract Shipping / Manifest history into data/tracking.csv.
 * Emits JSON-lines events for the Electron GUI.
 *
 * Flow:
 *   Get Manifests -> Get Manifest -> Get Manifest Shipments -> Get Shipment -> Get Shipment Details
 *
 * The generated tracking.csv uses clean headers and is consumed by get-tracking-cli.php.
 */

set_time_limit(0);
ini_set('display_errors', 'stderr');

$root = getenv('APP_ROOT') ?: realpath(dirname(__DIR__));
$dataDir = getenv('DATA_DIR') ?: ($root . DIRECTORY_SEPARATOR . 'data');
$stopFile = getenv('STOP_FILE') ?: ($dataDir . DIRECTORY_SEPARATOR . 'stop-requested.txt');
$outputFile = getenv('TRACKING_CSV') ?: ($dataDir . DIRECTORY_SEPARATOR . 'tracking.csv');
$userIni = file_exists($root . DIRECTORY_SEPARATOR . 'user.ini')
    ? ($root . DIRECTORY_SEPARATOR . 'user.ini')
    : ($dataDir . DIRECTORY_SEPARATOR . 'user.ini');
$cacert = file_exists($root . DIRECTORY_SEPARATOR . 'cacert.pem')
    ? ($root . DIRECTORY_SEPARATOR . 'cacert.pem')
    : ($dataDir . DIRECTORY_SEPARATOR . 'cacert.pem');

function emit_event($type, $payload = array()) {
    echo json_encode(array_merge(array('type' => $type), $payload), JSON_UNESCAPED_SLASHES) . PHP_EOL;
    flush();
}

function fail_event($message, $code = 1) {
    emit_event('error', array('message' => $message));
    exit($code);
}

function warn_event($message, $payload = array()) {
    emit_event('history_warning', array_merge(array('message' => $message), $payload));
}

function compact_number($value) {
    return preg_replace('/\D+/', '', trim((string) $value));
}

function normalize_date_yyyymmdd($value, $fieldName) {
    $value = trim((string) $value);
    if ($value === '') fail_event("Missing $fieldName date.");

    if (preg_match('/^\d{8}$/', $value)) {
        $dt = DateTime::createFromFormat('!Ymd', $value);
    } else {
        $dt = DateTime::createFromFormat('!Y-m-d', $value);
    }

    if (!$dt || $dt->format('Ymd') === '19700101') {
        $timestamp = strtotime($value);
        if ($timestamp === false) fail_event("Invalid $fieldName date: $value. Use YYYY-MM-DD.");
        $dt = new DateTime('@' . $timestamp);
        $dt->setTimezone(new DateTimeZone(date_default_timezone_get()));
    }

    return $dt->format('Ymd');
}

function yyyymmdd_to_iso($value) {
    $dt = DateTime::createFromFormat('!Ymd', $value);
    return $dt ? $dt->format('Y-m-d') : $value;
}

function normalize_postal_code($value) {
    return strtoupper(preg_replace('/\s+/', '', trim((string) $value)));
}

function one_line($value) {
    return preg_replace('/\s+/', ' ', trim((string) $value));
}

function safe_url($url) {
    $url = trim((string) $url);
    if (!preg_match('#^https://(?:ct\.)?soa-gw\.canadapost\.ca/#i', $url)) {
        fail_event('Unsafe Canada Post API URL returned by service: ' . $url);
    }
    return $url;
}

function http_get_xml($url, $accept, $username, $password, $cacert) {
    $url = safe_url($url);
    $headers = array(
        'Accept: ' . $accept,
        'Accept-language: en-CA',
    );

    if (extension_loaded('curl')) {
        $ch = curl_init($url);
        curl_setopt_array($ch, array(
            CURLOPT_RETURNTRANSFER => true,
            CURLOPT_HTTPHEADER => $headers,
            CURLOPT_USERPWD => $username . ':' . $password,
            CURLOPT_HTTPAUTH => CURLAUTH_BASIC,
            CURLOPT_TIMEOUT => 60,
            CURLOPT_CONNECTTIMEOUT => 20,
            CURLOPT_HEADER => true,
            CURLOPT_SSL_VERIFYPEER => true,
            CURLOPT_SSL_VERIFYHOST => 2,
        ));
        if ($cacert && file_exists($cacert)) curl_setopt($ch, CURLOPT_CAINFO, $cacert);

        $raw = curl_exec($ch);
        if ($raw === false) {
            $error = curl_error($ch);
            curl_close($ch);
            throw new Exception('HTTP request failed: ' . $error);
        }

        $status = (int) curl_getinfo($ch, CURLINFO_RESPONSE_CODE);
        $headerSize = (int) curl_getinfo($ch, CURLINFO_HEADER_SIZE);
        $body = substr($raw, $headerSize);
        curl_close($ch);

        if ($status < 200 || $status >= 300) {
            throw new Exception('Canada Post API returned HTTP ' . $status . ': ' . substr(one_line(strip_tags($body)), 0, 500));
        }

        return $body;
    }

    $contextOptions = array(
        'http' => array(
            'method' => 'GET',
            'header' => implode("\r\n", array_merge($headers, array(
                'Authorization: Basic ' . base64_encode($username . ':' . $password),
            ))),
            'timeout' => 60,
            'ignore_errors' => true,
        ),
        'ssl' => array(
            'verify_peer' => true,
            'verify_peer_name' => true,
        ),
    );
    if ($cacert && file_exists($cacert)) $contextOptions['ssl']['cafile'] = $cacert;

    $body = @file_get_contents($url, false, stream_context_create($contextOptions));
    if ($body === false) throw new Exception('HTTP request failed. Enable PHP curl for better diagnostics.');

    $status = 0;
    if (isset($http_response_header) && is_array($http_response_header)) {
        foreach ($http_response_header as $headerLine) {
            if (preg_match('#^HTTP/\S+\s+(\d+)#', $headerLine, $m)) $status = (int) $m[1];
        }
    }
    if ($status < 200 || $status >= 300) {
        throw new Exception('Canada Post API returned HTTP ' . $status . ': ' . substr(one_line(strip_tags($body)), 0, 500));
    }

    return $body;
}

function dom_from_xml($xml, $sourceLabel = 'XML') {
    $dom = new DOMDocument();
    $previous = libxml_use_internal_errors(true);
    $loaded = $dom->loadXML($xml);
    $errors = libxml_get_errors();
    libxml_clear_errors();
    libxml_use_internal_errors($previous);

    if (!$loaded) {
        $message = count($errors) ? trim($errors[0]->message) : 'unknown XML parse error';
        throw new Exception('Could not parse ' . $sourceLabel . ': ' . $message);
    }
    return $dom;
}

function xp_query($context, $query) {
    $doc = ($context instanceof DOMDocument) ? $context : $context->ownerDocument;
    $xp = new DOMXPath($doc);
    return $xp->query($query, $context);
}

function first_text($context, $query) {
    $nodes = xp_query($context, $query);
    if (!$nodes || $nodes->length === 0) return '';
    return one_line($nodes->item(0)->textContent);
}

function extract_links($xml, $sourceLabel = 'response') {
    $dom = dom_from_xml($xml, $sourceLabel);
    $nodes = xp_query($dom, '//*[local-name()="link"]');
    $links = array();

    foreach ($nodes as $node) {
        $links[] = array(
            'rel' => $node->getAttribute('rel'),
            'href' => $node->getAttribute('href'),
            'mediaType' => $node->getAttribute('media-type') ?: $node->getAttribute('mediaType'),
        );
    }

    return $links;
}

function links_by_rel($links, $rel) {
    return array_values(array_filter($links, function ($link) use ($rel) {
        return strcasecmp((string) $link['rel'], $rel) === 0 && trim((string) $link['href']) !== '';
    }));
}

function media_or_default($link, $default) {
    return !empty($link['mediaType']) ? $link['mediaType'] : $default;
}

function extract_manifest_id($href) {
    if (preg_match('#/manifest/([^/?]+)#', $href, $m)) return $m[1];
    return '';
}

function extract_shipment_id($href) {
    if (preg_match('#/shipment/([^/?]+)#', $href, $m)) return $m[1];
    return '';
}

function extract_shipment_info($xml, $shipmentHref) {
    $dom = dom_from_xml($xml, 'shipment');
    $trackingPin = first_text($dom, '//*[local-name()="tracking-pin"]');
    $shipmentId = first_text($dom, '//*[local-name()="shipment-id"]');
    if ($shipmentId === '') $shipmentId = extract_shipment_id($shipmentHref);

    $links = extract_links($xml, 'shipment links');
    $detailLinks = links_by_rel($links, 'details');
    $detailLink = count($detailLinks) ? $detailLinks[0] : array(
        'rel' => 'details',
        'href' => rtrim($shipmentHref, '/') . '/details',
        'mediaType' => 'application/vnd.cpc.shipment-v8+xml',
    );

    return array(
        'shipmentId' => $shipmentId,
        'trackingPin' => $trackingPin,
        'detailLink' => $detailLink,
        'customerRequestId' => first_text($dom, '//*[local-name()="customer-request-id"]'),
        'poNumber' => first_text($dom, '//*[local-name()="po-number"]'),
    );
}

function extract_shipment_detail($xml, $fallback = array()) {
    $dom = dom_from_xml($xml, 'shipment details');

    $trackingPin = first_text($dom, '//*[local-name()="tracking-pin"]');
    $postalCode = first_text($dom, '//*[local-name()="shipment-detail"]/*[local-name()="delivery-spec"]/*[local-name()="destination"]/*[local-name()="address-details"]/*[local-name()="postal-zip-code"]');
    if ($postalCode === '') {
        $postalCode = first_text($dom, '//*[local-name()="delivery-spec"]/*[local-name()="destination"]/*[local-name()="address-details"]/*[local-name()="postal-zip-code"]');
    }

    $customerRef = first_text($dom, '//*[local-name()="delivery-spec"]/*[local-name()="references"]/*[local-name()="customer-ref-1"]');
    if ($customerRef === '') $customerRef = first_text($dom, '//*[local-name()="customer-ref-1"]');
    if ($customerRef === '') $customerRef = isset($fallback['customerRequestId']) ? $fallback['customerRequestId'] : '';
    if ($customerRef === '') $customerRef = first_text($dom, '//*[local-name()="customer-request-id"]');
    if ($customerRef === '') $customerRef = isset($fallback['shipmentId']) ? $fallback['shipmentId'] : '';
    if ($customerRef === '') $customerRef = $trackingPin;

    return array(
        'trackingPin' => $trackingPin !== '' ? $trackingPin : (isset($fallback['trackingPin']) ? $fallback['trackingPin'] : ''),
        'postalCode' => normalize_postal_code($postalCode),
        'reference' => one_line($customerRef),
        'shipmentId' => isset($fallback['shipmentId']) ? $fallback['shipmentId'] : first_text($dom, '//*[local-name()="shipment-id"]'),
        'customerRequestId' => first_text($dom, '//*[local-name()="customer-request-id"]') ?: (isset($fallback['customerRequestId']) ? $fallback['customerRequestId'] : ''),
        'serviceCode' => first_text($dom, '//*[local-name()="delivery-spec"]/*[local-name()="service-code"]'),
        'destinationCity' => first_text($dom, '//*[local-name()="delivery-spec"]/*[local-name()="destination"]/*[local-name()="address-details"]/*[local-name()="city"]'),
        'destinationProvince' => first_text($dom, '//*[local-name()="delivery-spec"]/*[local-name()="destination"]/*[local-name()="address-details"]/*[local-name()="prov-state"]'),
    );
}

function stop_requested($stopFile) {
    return $stopFile && file_exists($stopFile);
}

function date_range_days($fromYmd, $toYmd) {
    $days = array();
    $start = DateTime::createFromFormat('!Ymd', $fromYmd);
    $end = DateTime::createFromFormat('!Ymd', $toYmd);
    while ($start && $end && $start <= $end) {
        $days[] = $start->format('Ymd');
        $start->modify('+1 day');
    }
    return $days;
}

if (!extension_loaded('dom')) fail_event('PHP DOM extension is not enabled.');
if (!extension_loaded('libxml')) fail_event('PHP libxml extension is not enabled.');
if (!file_exists($userIni)) fail_event("Missing user.ini at $userIni");
if (!file_exists($cacert)) fail_event("Missing cacert.pem at $cacert");

$userProperties = parse_ini_file($userIni);
if (!$userProperties || empty($userProperties['username']) || empty($userProperties['password'])) {
    fail_event('user.ini must contain username=... and password=... for the Canada Post API.');
}

$from = normalize_date_yyyymmdd(getenv('HISTORY_FROM') ?: '', 'from');
$to = normalize_date_yyyymmdd(getenv('HISTORY_TO') ?: '', 'to');
if ($from > $to) fail_event('History import date range is invalid: from date is after to date.');

$customerNumber = compact_number(getenv('HISTORY_CUSTOMER_NUMBER') ?: ($userProperties['customerNumber'] ?? ''));
$mobo = compact_number(getenv('HISTORY_MOBO') ?: ($userProperties['mobo'] ?? $customerNumber));
$includeNoManifest = in_array(strtolower((string) (getenv('HISTORY_INCLUDE_NO_MANIFEST') ?: 'false')), array('1', 'true', 'yes'), true);
$host = getenv('CANADAPOST_REST_HOST') ?: 'soa-gw.canadapost.ca';

if ($customerNumber === '') fail_event('Missing Canada Post customer number. Add customerNumber=... to user.ini or enter it in the app.');
if ($mobo === '') $mobo = $customerNumber;

@mkdir($dataDir, 0775, true);

emit_event('history_start', array(
    'from' => yyyymmdd_to_iso($from),
    'to' => yyyymmdd_to_iso($to),
    'customerNumber' => $customerNumber,
    'mobo' => $mobo,
    'includeNoManifest' => $includeNoManifest,
));

$username = (string) $userProperties['username'];
$password = (string) $userProperties['password'];
$manifestAccept = 'application/vnd.cpc.manifest-v8+xml';
$shipmentAccept = 'application/vnd.cpc.shipment-v8+xml';
$shipments = array();
$seenPins = array();
$warnings = 0;

try {
    $manifestUrl = 'https://' . $host . '/rs/' . rawurlencode($customerNumber) . '/' . rawurlencode($mobo) . '/manifest?start=' . rawurlencode($from) . '&end=' . rawurlencode($to);
    $manifestListXml = http_get_xml($manifestUrl, $manifestAccept, $username, $password, $cacert);
    $manifestLinks = links_by_rel(extract_links($manifestListXml, 'manifest list'), 'manifest');
    emit_event('history_manifest_list', array('count' => count($manifestLinks)));

    foreach ($manifestLinks as $manifestIndex => $manifestLink) {
        if (stop_requested($stopFile)) {
            emit_event('history_stopped', array('imported' => count($shipments)));
            break;
        }

        $manifestId = extract_manifest_id($manifestLink['href']);
        emit_event('history_manifest', array(
            'index' => $manifestIndex + 1,
            'total' => count($manifestLinks),
            'manifestId' => $manifestId,
        ));

        try {
            $manifestXml = http_get_xml($manifestLink['href'], media_or_default($manifestLink, $manifestAccept), $username, $password, $cacert);
            $manifestDom = dom_from_xml($manifestXml, 'manifest');
            $poNumber = first_text($manifestDom, '//*[local-name()="po-number"]');
            $manifestResponseLinks = extract_links($manifestXml, 'manifest');
            $manifestShipmentLinks = links_by_rel($manifestResponseLinks, 'manifestShipments');

            if (count($manifestShipmentLinks) === 0) {
                $warnings++;
                warn_event('Manifest had no manifestShipments link.', array('manifestId' => $manifestId));
                continue;
            }

            foreach ($manifestShipmentLinks as $manifestShipmentLink) {
                $shipmentsXml = http_get_xml($manifestShipmentLink['href'], media_or_default($manifestShipmentLink, $shipmentAccept), $username, $password, $cacert);
                $shipmentLinks = links_by_rel(extract_links($shipmentsXml, 'manifest shipments'), 'shipment');
                emit_event('history_shipments', array('manifestId' => $manifestId, 'count' => count($shipmentLinks)));

                foreach ($shipmentLinks as $shipmentIndex => $shipmentLink) {
                    if (stop_requested($stopFile)) {
                        emit_event('history_stopped', array('imported' => count($shipments)));
                        break 3;
                    }

                    $shipmentId = extract_shipment_id($shipmentLink['href']);
                    try {
                        $shipmentXml = http_get_xml($shipmentLink['href'], media_or_default($shipmentLink, $shipmentAccept), $username, $password, $cacert);
                        $shipmentInfo = extract_shipment_info($shipmentXml, $shipmentLink['href']);
                        $detailLink = $shipmentInfo['detailLink'];
                        $detailsXml = http_get_xml($detailLink['href'], media_or_default($detailLink, $shipmentAccept), $username, $password, $cacert);
                        $detail = extract_shipment_detail($detailsXml, $shipmentInfo);
                        $pin = trim((string) $detail['trackingPin']);

                        if ($pin === '') {
                            $warnings++;
                            warn_event('Shipment had no tracking PIN and was skipped.', array('shipmentId' => $shipmentId));
                            continue;
                        }
                        if (isset($seenPins[$pin])) continue;

                        $seenPins[$pin] = true;
                        $row = array(
                            'trackingPin' => $pin,
                            'postalCode' => $detail['postalCode'],
                            'reference' => $detail['reference'],
                            'shipmentId' => $detail['shipmentId'] ?: $shipmentId,
                            'manifestId' => $manifestId,
                            'poNumber' => $poNumber,
                            'serviceCode' => $detail['serviceCode'],
                            'destinationCity' => $detail['destinationCity'],
                            'destinationProvince' => $detail['destinationProvince'],
                            'source' => 'manifest',
                        );
                        $shipments[] = $row;
                        emit_event('history_imported', array(
                            'pin' => $pin,
                            'postalCode' => $row['postalCode'],
                            'reference' => $row['reference'],
                            'current' => count($shipments),
                        ));
                    } catch (Exception $e) {
                        $warnings++;
                        warn_event('Shipment import failed: ' . $e->getMessage(), array('shipmentId' => $shipmentId));
                    }

                    usleep(75000);
                }
            }
        } catch (Exception $e) {
            $warnings++;
            warn_event('Manifest import failed: ' . $e->getMessage(), array('manifestId' => $manifestId));
        }
    }

    if ($includeNoManifest) {
        $days = date_range_days($from, $to);
        foreach ($days as $dayIndex => $day) {
            if (stop_requested($stopFile)) break;
            $noManifestUrl = 'https://' . $host . '/rs/' . rawurlencode($customerNumber) . '/' . rawurlencode($mobo) . '/shipment?noManifest=true&date=' . rawurlencode($day) . '&limit=99999';
            emit_event('history_no_manifest_day', array('date' => yyyymmdd_to_iso($day), 'index' => $dayIndex + 1, 'total' => count($days)));

            try {
                $shipmentsXml = http_get_xml($noManifestUrl, $shipmentAccept, $username, $password, $cacert);
                $shipmentLinks = links_by_rel(extract_links($shipmentsXml, 'no-manifest shipments'), 'shipment');
                emit_event('history_shipments', array('manifestId' => 'noManifest:' . $day, 'count' => count($shipmentLinks)));

                foreach ($shipmentLinks as $shipmentLink) {
                    $shipmentId = extract_shipment_id($shipmentLink['href']);
                    try {
                        $shipmentXml = http_get_xml($shipmentLink['href'], media_or_default($shipmentLink, $shipmentAccept), $username, $password, $cacert);
                        $shipmentInfo = extract_shipment_info($shipmentXml, $shipmentLink['href']);
                        $detailsXml = http_get_xml($shipmentInfo['detailLink']['href'], media_or_default($shipmentInfo['detailLink'], $shipmentAccept), $username, $password, $cacert);
                        $detail = extract_shipment_detail($detailsXml, $shipmentInfo);
                        $pin = trim((string) $detail['trackingPin']);

                        if ($pin === '' || isset($seenPins[$pin])) continue;
                        $seenPins[$pin] = true;
                        $row = array(
                            'trackingPin' => $pin,
                            'postalCode' => $detail['postalCode'],
                            'reference' => $detail['reference'],
                            'shipmentId' => $detail['shipmentId'] ?: $shipmentId,
                            'manifestId' => '',
                            'poNumber' => $shipmentInfo['poNumber'] ?? '',
                            'serviceCode' => $detail['serviceCode'],
                            'destinationCity' => $detail['destinationCity'],
                            'destinationProvince' => $detail['destinationProvince'],
                            'source' => 'noManifest',
                        );
                        $shipments[] = $row;
                        emit_event('history_imported', array(
                            'pin' => $pin,
                            'postalCode' => $row['postalCode'],
                            'reference' => $row['reference'],
                            'current' => count($shipments),
                        ));
                    } catch (Exception $e) {
                        $warnings++;
                        warn_event('No-manifest shipment import failed: ' . $e->getMessage(), array('shipmentId' => $shipmentId));
                    }
                    usleep(75000);
                }
            } catch (Exception $e) {
                // 404 is common for days without no-manifest shipments; report as warning but continue.
                $warnings++;
                warn_event('No-manifest lookup failed: ' . $e->getMessage(), array('date' => yyyymmdd_to_iso($day)));
            }
        }
    }

    if (count($shipments) === 0) {
        emit_event('history_complete', array('imported' => 0, 'warnings' => $warnings, 'trackingCsv' => $outputFile));
        exit(2);
    }

    $tmpFile = $outputFile . '.tmp';
    $handle = fopen($tmpFile, 'w');
    if ($handle === false) fail_event('Could not write temporary tracking CSV: ' . $tmpFile);

    fputcsv($handle, array(
        'Tracking PIN',
        'Destination Postal Code',
        'Reference #',
        'Shipment ID',
        'Manifest ID',
        'PO Number',
        'Service Code',
        'Destination City',
        'Destination Province',
        'Source',
    ));

    foreach ($shipments as $row) {
        fputcsv($handle, array(
            $row['trackingPin'],
            $row['postalCode'],
            $row['reference'],
            $row['shipmentId'],
            $row['manifestId'],
            $row['poNumber'],
            $row['serviceCode'],
            $row['destinationCity'],
            $row['destinationProvince'],
            $row['source'],
        ));
    }
    fclose($handle);

    if (file_exists($outputFile)) {
        $backup = $dataDir . DIRECTORY_SEPARATOR . 'tracking-backup-before-history-import-' . date('Ymd-His') . '.csv';
        @copy($outputFile, $backup);
        emit_event('history_backup', array('path' => $backup));
    }

    rename($tmpFile, $outputFile);

    emit_event('history_complete', array(
        'imported' => count($shipments),
        'warnings' => $warnings,
        'trackingCsv' => $outputFile,
    ));
    exit(0);
} catch (Exception $e) {
    fail_event($e->getMessage());
}
