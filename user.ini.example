; Copy this file to the app's per-user data folder as user.ini.
; Open that folder with the app's "Open data folder" button.
; Deprecated legacy Developer Program credentials retained only for migration and
; legacy shipping-history compatibility. Step 2 never uses these values.
apiUsername=YOUR_DEVELOPER_PROGRAM_API_USERNAME
apiPassword=YOUR_DEVELOPER_PROGRAM_API_PASSWORD
apiEnvironment=production
; Save the current Tracking API client ID / API Key and client secret / API Secret
; in the app Settings screen so they use encrypted secret storage. They are not
; accepted from this plaintext file. Select trackingApiEnvironment=test or production in Settings.
customerNumber=YOUR_CUSTOMER_NUMBER
; mobo=OPTIONAL_MAILED_ON_BEHALF_OF_NUMBER
